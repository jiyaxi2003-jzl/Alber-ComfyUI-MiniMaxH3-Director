# 统一换行：仓库里存 LF，检出时按平台转换
* text=auto eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.bat  text eol=crlf

# 二进制，别做任何转换或 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.webm binary
*.safetensors binary
*.zip  binary

# 语言统计：图片不算代码量
docs/images/* linguist-documentation
